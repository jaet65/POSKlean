{
  "name": "POSKlean",
  "private": true,
  "version": "0.0.3",
  "description": "POSKlean Desktop Application",
  "author": "Klean",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:icons": "electron electron/render-icon.cjs && powershell -ExecutionPolicy Bypass -File electron/generate-ico.ps1",
    "android:icons": "electron electron/generate-android-icons.cjs",
    "icons": "npm run electron:icons && npm run android:icons",
    "electron:dev": "cross-env ELECTRON_DEV=1 electron .",
    "electron:start": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder --publish never",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:live": "vite",
    "cap:ios": "npm run cap:sync && cap open ios"
  },
  "build": {
    "appId": "com.posklean.app",
    "productName": "POSKlean",
    "publish": [
      {
        "provider": "github",
        "owner": "jaet65",
        "repo": "POSKlean",
        "private": true
      }
    ],
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "POSKlean-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "POSKlean-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/core": "^8.5.3",
    "@capgo/capacitor-printer": "^8.1.8",
    "electron-updater": "^6.8.9",
    "firebase": "*",
    "lucide-react": "^1.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.4.3",
    "@capacitor/ios": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.5.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "protobufjs@*": true,
    "electron-winstaller@5.4.0": true
  }
}
