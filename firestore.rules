rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Identity: every signed-in person has a Firebase Auth uid. Username/password
// accounts use a fictitious email "<username>@posklean.invalid"; the super admin
// signs in with Google. Authorization always comes from the profile document
// users/{uid}, never from data supplied by the caller.
//
// Collection: users            Document ID: Firebase Auth uid
//   uid: string (== document ID), username?: string, email: string,
//   displayName: string, photoURL?: string|null, authType: 'credentials'|'google',
//   role: 'admin'|'supervisor'|'cajero'|'custom',
//   status: 'active'|'inactive'|'pending',
//   permissions: map {pos, inventory, sales, users: bool},
//   storeId?: string, createdAt/updatedAt/lastLogin?: ISO string
//
// Collection: stores           Document ID: auto
//   name, address?, phone?, status ('active'|'archived'), cashierIds: list<string>;
//   openCashShiftCount: int (defaults to 0 and must be 0 when archived)
//
// Collection: catalogProducts   Document ID: auto (never deleted, only archived)
//   name, category, unit, color: string; price: number (global default sale price);
//   minStock?: number (default minimum stock suggested when enabling in a store);
//   status: 'active'|'archived'; createdBy: map; createdAt, updatedAt: timestamp
//   Written only by admins and supervisors; readable by any active staff.
//
// Collection: stockItems        Document ID: "<storeId>_<catalogId>"
//   catalogId, storeId: string; currentStock, minStock, cost: number;
//   priceOverride?: number|null (store-specific price, falls back to catalog price);
//   createdBy: map; createdAt: timestamp; restock/min-stock audit metadata
//   Only admins and supervisors enable a catalog product in a store.
//
// Collection: sales            Document ID: auto (immutable once created)
//   ticketId, channel, paymentMethod, shiftId, cashierId: string; items: list;
//   total: number; totalCents, liters: number; createdBy: map;
//   storeId: string; timestamp: timestamp
//
// Collection: cashShifts        Document ID: auto
//   shiftId, cashierId, storeId, status: string; openingCashCents: int; openedBy: map;
//   openedAt: timestamp; paymentTotalsCents and saleCount update atomically with
//   each sale; countedCashCents, expectedCashCents and cashDifferenceCents are
//   written atomically on closure and never change afterwards
//
// Collection: cashRegisters     Document ID: cashier UID
//   cashierId, storeId, shiftId, status: string; updatedAt: timestamp
//
// Collection: inventoryMovements   Document ID: auto (immutable once created)
//   type ('sale'|'restock'|'initial'|'audit'|'purchase'), productId, productName, unit: string;
//   amount, previousStock, newStock: number;
//   createdBy: map; storeId: string; timestamp: timestamp; audit-only extra fields
//
// Collection: suppliers         Document ID: auto (never deleted, only archived)
//   name: string; contactName, phone, email, notes?: string;
//   status: 'active'|'archived'; createdBy: map; createdAt, updatedAt: timestamp
//
// Collection: purchaseOrders    Document ID: auto
//   storeId, supplierId, supplierName, orderNumber: string;
//   status: 'pending'|'partial'|'received'|'cancelled';
//   items: list of {productId, productName, unit, qtyOrdered, qtyReceived, unitCostCents};
//   totalCents, receivedCents: int; notes?: string; createdBy: map;
//   createdAt, updatedAt: timestamp; receivedAt?, cancelledAt?: timestamp
//   Only admins and supervisors read or write suppliers and purchase orders.
//
// Known limits: stock/price numbers written by the client cannot be fully
// verified server-side; a malicious cashier of a store could still alter stock or
// sale totals for that store. Fixing that requires server-side code.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // The super admin is bootstrapped by a verified Google account, so nobody can
    // claim it by registering that address with email/password.
    function isSuperAdmin() {
      return isAuthenticated()
        && request.auth.token.email == 'agrazmario@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return isAuthenticated() && exists(profilePath());
    }

    function profile() {
      return get(profilePath()).data;
    }

    function storePath(storeId) {
      return /databases/$(database)/documents/stores/$(storeId);
    }

    function cashShiftPath(shiftId) {
      return /databases/$(database)/documents/cashShifts/$(shiftId);
    }

    function cashRegisterPath(cashierId) {
      return /databases/$(database)/documents/cashRegisters/$(cashierId);
    }

    function salePath(saleId) {
      return /databases/$(database)/documents/sales/$(saleId);
    }

    function storeOpenShiftCountIncreased(storeId) {
      let before = get(storePath(storeId)).data.get('openCashShiftCount', 0);
      return getAfter(storePath(storeId)).data.get('openCashShiftCount', 0) == before + 1;
    }

    function storeOpenShiftCountDecreased(storeId) {
      let before = get(storePath(storeId)).data.get('openCashShiftCount', 0);
      return before > 0
        && getAfter(storePath(storeId)).data.get('openCashShiftCount', 0) == before - 1;
    }

    // Counter changes are checked against the register and shift written in the same batch.
    function isCashShiftStoreCounterIncrease(storeId) {
      let registerAfter = getAfter(cashRegisterPath(request.auth.uid)).data;
      let shiftAfter = getAfter(cashShiftPath(registerAfter.shiftId)).data;
      return isAuthenticated()
        && changedKeys().hasOnly(['openCashShiftCount'])
        && resource.data.get('status', 'active') == 'active'
        && request.resource.data.openCashShiftCount is int
        && request.resource.data.openCashShiftCount <= 100000
        && request.resource.data.openCashShiftCount
          == resource.data.get('openCashShiftCount', 0) + 1
        && registerAfter.status == 'open'
        && registerAfter.storeId == storeId
        && shiftAfter.status == 'open'
        && shiftAfter.storeId == storeId
        && shiftAfter.cashierId == request.auth.uid;
    }

    function isCashShiftStoreCounterDecrease(storeId) {
      let registerAfter = getAfter(cashRegisterPath(request.auth.uid)).data;
      let shiftAfter = getAfter(cashShiftPath(registerAfter.shiftId)).data;
      return isAuthenticated()
        && changedKeys().hasOnly(['openCashShiftCount'])
        && resource.data.get('openCashShiftCount', 0) > 0
        && request.resource.data.openCashShiftCount is int
        && request.resource.data.openCashShiftCount
          == resource.data.get('openCashShiftCount', 0) - 1
        && registerAfter.status == 'closed'
        && registerAfter.storeId == storeId
        && shiftAfter.status == 'closed'
        && shiftAfter.storeId == storeId
        && shiftAfter.cashierId == request.auth.uid;
    }

    function isActiveStore(storeId) {
      return storeId is string
        && storeId.size() > 0
        && exists(storePath(storeId))
        && get(storePath(storeId)).data.get('status', 'active') == 'active';
    }

    function isActiveStoreAfter(storeId) {
      return storeId is string
        && storeId.size() > 0
        && existsAfter(storePath(storeId))
        && getAfter(storePath(storeId)).data.get('status', 'active') == 'active';
    }

    function isActiveStaff() {
      return isSuperAdmin() || (hasProfile() && profile().status == 'active');
    }

    function isAdmin() {
      return isSuperAdmin() || (isActiveStaff() && profile().role == 'admin');
    }

    // Suppliers and purchase orders are managed by administrators and supervisors.
    function isPurchasingStaff() {
      return isAdmin() || (isActiveStaff() && profile().role == 'supervisor');
    }

    function supplierPath(supplierId) {
      return /databases/$(database)/documents/suppliers/$(supplierId);
    }

    // Cashiers are confined to their assigned store; other active roles see all stores.
    function canAccessStore(storeId) {
      return isAdmin()
        || (isActiveStaff()
          && storeId is string
          && isActiveStore(storeId)
          && (profile().role != 'cajero'
            || (profile().get('storeId', '') != '' && profile().storeId == storeId)));
    }

    function canOperateStore(storeId) {
      return canAccessStore(storeId) && isActiveStore(storeId);
    }

    function canOperatePOS() {
      return isAdmin()
        || (isActiveStaff() && profile().get('permissions', {}).get('pos', false) == true);
    }

    function hasOnlyKeys(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }


    function validText(value, maxLen) {
      return value is string && value.size() <= maxLen;
    }

    function validOptionalText(data, field, maxLen) {
      return !(field in data) || data[field] == null || validText(data[field], maxLen);
    }

    function validNonNegative(value) {
      return value is number && value >= 0 && value < 1000000000;
    }

    // The author recorded in a document must be the signed-in user.
    function isOwnAuthorship(createdBy) {
      return createdBy is map && createdBy.get('userId', null) == request.auth.uid;
    }

    // A missing document makes getAfter()/get() fail, which denies the request.
    function isOpenShiftLinkedToRegister(data) {
      let shiftAfter = getAfter(cashShiftPath(data.shiftId)).data;
      let registerAfter = getAfter(cashRegisterPath(data.cashierId)).data;
      return data.cashierId == request.auth.uid
        && shiftAfter.status == 'open'
        && shiftAfter.cashierId == data.cashierId
        && shiftAfter.storeId == data.storeId
        && registerAfter.status == 'open'
        && registerAfter.shiftId == data.shiftId
        && registerAfter.storeId == data.storeId
        && storeOpenShiftCountIncreased(data.storeId);
    }

    function isClosedShiftLinkedToRegister(data) {
      let shiftAfter = getAfter(cashShiftPath(data.shiftId)).data;
      return data.cashierId == request.auth.uid
        && shiftAfter.status == 'closed'
        && shiftAfter.cashierId == data.cashierId
        && shiftAfter.storeId == data.storeId
        && storeOpenShiftCountDecreased(data.storeId);
    }

    function isSaleForOpenCashShift(data) {
      let shift = get(cashShiftPath(data.shiftId)).data;
      let register = get(cashRegisterPath(request.auth.uid)).data;
      return data.cashierId == request.auth.uid
        && data.shiftId is string
        && data.shiftId.size() > 0
        && shift.status == 'open'
        && shift.cashierId == request.auth.uid
        && shift.storeId == data.storeId
        && register.status == 'open'
        && register.shiftId == data.shiftId
        && register.storeId == data.storeId;
    }

    function isValidCashShiftSaleUpdate(oldData, newData, shiftId) {
      let sale = getAfter(salePath(newData.lastSaleId)).data;
      let oldTotals = oldData.paymentTotalsCents;
      let newTotals = newData.paymentTotalsCents;
      return newData.status == 'open'
        && changedKeys().hasOnly(['paymentTotalsCents', 'saleCount', 'lastSaleId'])
        && newTotals.keys().hasOnly(['cash', 'card', 'transfer'])
        && newData.lastSaleId is string && newData.lastSaleId.size() > 0
        && newData.lastSaleId != oldData.get('lastSaleId', '')
        && !exists(salePath(newData.lastSaleId))
        && sale.shiftId == shiftId
        && sale.cashierId == request.auth.uid
        && sale.storeId == oldData.storeId
        && sale.createdBy.get('userId', null) == request.auth.uid
        && sale.totalCents is int
        && newData.saleCount == oldData.saleCount + 1
        && newData.saleCount <= 100000
        && (
          (sale.paymentMethod == 'cash'
            && newTotals.cash == oldTotals.cash + sale.totalCents
            && newTotals.card == oldTotals.card
            && newTotals.transfer == oldTotals.transfer)
          || (sale.paymentMethod == 'card'
            && newTotals.card == oldTotals.card + sale.totalCents
            && newTotals.cash == oldTotals.cash
            && newTotals.transfer == oldTotals.transfer)
          || (sale.paymentMethod == 'transfer'
            && newTotals.transfer == oldTotals.transfer + sale.totalCents
            && newTotals.cash == oldTotals.cash
            && newTotals.card == oldTotals.card)
        );
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function validPermissions(permissions) {
      return permissions is map
        && permissions.keys().hasOnly(['pos', 'inventory', 'sales', 'users'])
        && permissions.keys().hasAll(['pos', 'inventory', 'sales', 'users'])
        && permissions.pos is bool && permissions.inventory is bool
        && permissions.sales is bool && permissions.users is bool;
    }

    function isValidUser(data) {
      return data.role in ['admin', 'supervisor', 'cajero', 'custom']
        && data.status in ['active', 'inactive', 'pending']
        && validPermissions(data.permissions)
        && validText(data.get('displayName', ''), 100)
        && validText(data.get('email', ''), 200)
        && validOptionalText(data, 'username', 40)
        && validOptionalText(data, 'storeId', 100)
        && validOptionalText(data, 'photoURL', 500)
        && validOptionalText(data, 'createdAt', 40)
        && validOptionalText(data, 'updatedAt', 40)
        && validOptionalText(data, 'lastLogin', 40)
        && (data.get('storeId', '') == '' || data.get('storeId', '') == null
          || isActiveStoreAfter(data.storeId))
        && data.get('authType', 'credentials') in ['credentials', 'google'];
    }

    function isNewUserProfile(data, userId) {
      return hasOnlyKeys(data, ['uid', 'username', 'email', 'displayName', 'photoURL',
          'authType', 'role', 'status', 'permissions', 'storeId', 'createdAt',
          'updatedAt', 'lastLogin'])
        && data.uid == userId
        && data.keys().hasAll(['uid', 'email', 'displayName', 'authType', 'role', 'status', 'permissions'])
        && isValidUser(data);
    }

    // A signed-in Google user may only create a pending, permission-less profile.
    function isSelfRegistration(data) {
      return hasOnlyKeys(data, ['uid', 'email', 'displayName', 'photoURL', 'authType',
          'role', 'status', 'permissions', 'createdAt', 'lastLogin'])
        && data.keys().hasAll(['uid', 'email', 'displayName', 'authType', 'role', 'status', 'permissions'])
        && data.uid == request.auth.uid
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && data.email == request.auth.token.email.lower()
        && data.authType == 'google'
        && data.role == 'cajero'
        && data.status == 'pending'
        && data.permissions.pos == false && data.permissions.inventory == false
        && data.permissions.sales == false && data.permissions.users == false
        && isValidUser(data);
    }

    function isValidStore(data) {
      return validText(data.get('name', ''), 120) && data.get('name', '') != ''
        && validText(data.get('address', ''), 300)
        && validText(data.get('phone', ''), 40)
        && data.get('status', 'active') in ['active', 'archived']
        && data.get('cashierIds', []) is list
        && data.get('cashierIds', []).size() <= 200
        && data.get('openCashShiftCount', 0) is int
        && data.get('openCashShiftCount', 0) >= 0
        && data.get('openCashShiftCount', 0) <= 100000
        && (data.get('status', 'active') != 'archived'
          || data.get('openCashShiftCount', 0) == 0)
        && (data.get('status', 'active') != 'archived' || data.get('cashierIds', []).size() == 0);
    }

    function hasValidStockFields(data) {
      return validText(data.catalogId, 100) && data.catalogId.size() > 0
        && validNonNegative(data.currentStock)
        && validNonNegative(data.minStock)
        && validNonNegative(data.cost)
        && (data.get('priceOverride', null) == null
          || (validNonNegative(data.priceOverride) && data.priceOverride > 0))
        && data.storeId is string && data.storeId.size() > 0 && data.storeId.size() <= 100;
    }

    function catalogPath(catalogId) {
      return /databases/$(database)/documents/catalogProducts/$(catalogId);
    }

    function hasValidCatalogFields(data) {
      return validText(data.name, 120) && data.name.size() > 0
        && validText(data.category, 60) && data.category.size() > 0
        && validText(data.get('unit', 'L'), 10)
        && validText(data.get('color', ''), 40)
        && validNonNegative(data.price) && data.price > 0
        && validNonNegative(data.get('minStock', 0))
        && data.status in ['active', 'archived'];
    }

    function isNewCatalogProduct(data) {
      return hasOnlyKeys(data, ['name', 'category', 'unit', 'color', 'price', 'minStock', 'status',
          'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['name', 'category', 'price', 'status', 'createdBy', 'createdAt',
          'updatedAt'])
        && hasValidCatalogFields(data)
        && data.status == 'active'
        && isOwnAuthorship(data.createdBy)
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    // Stock documents use the deterministic ID "<storeId>_<catalogId>".
    function isNewStockItem(stockId, data) {
      return hasOnlyKeys(data, ['catalogId', 'storeId', 'currentStock', 'minStock', 'cost',
          'priceOverride', 'createdBy', 'createdAt'])
        && data.keys().hasAll(['catalogId', 'storeId', 'currentStock', 'minStock', 'cost',
          'createdBy', 'createdAt'])
        && hasValidStockFields(data)
        && stockId == data.storeId + '_' + data.catalogId
        && existsAfter(catalogPath(data.catalogId))
        && getAfter(catalogPath(data.catalogId)).data.status == 'active'
        && isOwnAuthorship(data.createdBy)
        && data.createdAt == request.time;
    }

    function isValidSale(data) {
      return hasOnlyKeys(data, ['ticketId', 'channel', 'items', 'total', 'liters',
          'createdBy', 'storeId', 'timestamp', 'paymentMethod', 'shiftId', 'cashierId',
          'totalCents'])
        && data.keys().hasAll(['ticketId', 'channel', 'items', 'total', 'liters',
          'createdBy', 'storeId', 'timestamp', 'paymentMethod', 'shiftId', 'cashierId',
          'totalCents'])
        && validText(data.ticketId, 40)
        && validText(data.channel, 60) && data.channel.size() > 0
        && data.cashierId == request.auth.uid
        && data.paymentMethod in ['cash', 'card', 'transfer']
        && isSaleForOpenCashShift(data)
        && data.items is list && data.items.size() > 0 && data.items.size() <= 100
        && validNonNegative(data.total)
        && data.totalCents is int && data.totalCents >= 0 && data.totalCents < 100000000000
        && data.total == data.totalCents / 100
        && validNonNegative(data.liters)
        && isOwnAuthorship(data.createdBy)
        && data.timestamp == request.time;
    }

    // Rules for opening a shift: only a fresh, empty shift can be created.
    function isValidOpenCashShift(data, shiftId) {
      return hasOnlyKeys(data, ['shiftId', 'cashierId', 'storeId', 'status', 'openingCashCents',
          'openedBy', 'openedAt', 'paymentTotalsCents', 'saleCount'])
        && data.keys().hasAll(['shiftId', 'cashierId', 'storeId', 'status', 'openingCashCents',
          'openedBy', 'openedAt', 'paymentTotalsCents', 'saleCount'])
        && data.shiftId == shiftId
        && data.cashierId == request.auth.uid
        && validText(data.storeId, 100) && data.storeId.size() > 0
        && data.status == 'open'
        && data.openingCashCents is int
        && data.openingCashCents >= 0 && data.openingCashCents < 100000000000
        && data.openedBy.keys().hasOnly(['userId', 'userName', 'userRole'])
        && data.openedBy.userId == request.auth.uid
        && validText(data.openedBy.userName, 100)
        && data.openedBy.userRole in ['admin', 'supervisor', 'cajero', 'custom']
        && data.openedAt == request.time
        && data.paymentTotalsCents == {'cash': 0, 'card': 0, 'transfer': 0}
        && data.saleCount == 0;
    }

    // Closing only adds the count fields; expected cash is derived from stored values.
    function isValidCashShiftClose(oldData, newData) {
      let expected = oldData.openingCashCents + oldData.paymentTotalsCents.cash;
      return newData.status == 'closed'
        && changedKeys().hasOnly(['status', 'closedBy', 'closedAt', 'countedCashCents',
          'expectedCashCents', 'cashDifferenceCents'])
        && newData.keys().hasAll(['closedBy', 'closedAt', 'countedCashCents',
          'expectedCashCents', 'cashDifferenceCents'])
        && newData.closedBy.keys().hasOnly(['userId', 'userName', 'userRole'])
        && newData.closedBy.userId == request.auth.uid
        && validText(newData.closedBy.userName, 100)
        && newData.closedBy.userRole in ['admin', 'supervisor', 'cajero', 'custom']
        && newData.closedAt == request.time
        && newData.countedCashCents is int
        && newData.countedCashCents >= 0 && newData.countedCashCents < 100000000000
        && newData.expectedCashCents == expected
        && newData.cashDifferenceCents == newData.countedCashCents - expected
        && isClosedShiftLinkedToRegister(newData);
    }

    function isValidCashRegister(data, cashierId) {
      return hasOnlyKeys(data, ['cashierId', 'storeId', 'shiftId', 'status', 'updatedAt'])
        && data.keys().hasAll(['cashierId', 'storeId', 'shiftId', 'status', 'updatedAt'])
        && data.cashierId == cashierId
        && validText(data.storeId, 100) && data.storeId.size() > 0
        && validText(data.shiftId, 100) && data.shiftId.size() > 0
        && data.status in ['open', 'closed']
        && data.updatedAt == request.time;
    }

    function isValidMovement(data) {
      return data.type in ['sale', 'restock', 'initial', 'audit', 'purchase']
        && validText(data.get('productId', ''), 100) && data.get('productId', '') != ''
        && validText(data.get('productName', ''), 120)
        && validText(data.get('unit', 'L'), 10)
        && data.amount is number
        && validNonNegative(data.newStock)
        && data.previousStock is number
        && isOwnAuthorship(data.createdBy)
        && data.timestamp == request.time
        && data.keys().size() <= 30;
    }

    function isNewSupplier(data) {
      return hasOnlyKeys(data, ['name', 'contactName', 'phone', 'email', 'notes', 'status',
          'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['name', 'status', 'createdBy', 'createdAt', 'updatedAt'])
        && isValidSupplierFields(data)
        && data.status == 'active'
        && isOwnAuthorship(data.createdBy)
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidSupplierFields(data) {
      return validText(data.get('name', ''), 120) && data.get('name', '') != ''
        && validOptionalText(data, 'contactName', 120)
        && validOptionalText(data, 'phone', 40)
        && validOptionalText(data, 'email', 200)
        && validOptionalText(data, 'notes', 500)
        && data.status in ['active', 'archived'];
    }

    function isSupplierUpdate(newData) {
      return changedKeys().hasOnly(['name', 'contactName', 'phone', 'email', 'notes',
          'status', 'updatedAt'])
        && isValidSupplierFields(newData)
        && newData.updatedAt == request.time;
    }

    // Order lines are validated by the app: security rules cannot loop over lists.
    function isNewPurchaseOrder(data) {
      let supplier = get(supplierPath(data.supplierId)).data;
      return hasOnlyKeys(data, ['storeId', 'supplierId', 'supplierName', 'status', 'items',
          'totalCents', 'receivedCents', 'orderNumber', 'notes', 'createdBy', 'createdAt',
          'updatedAt'])
        && data.keys().hasAll(['storeId', 'supplierId', 'supplierName', 'status', 'items',
          'totalCents', 'receivedCents', 'orderNumber', 'createdBy', 'createdAt', 'updatedAt'])
        && data.status == 'pending'
        && validText(data.supplierId, 100) && data.supplierId.size() > 0
        && validText(data.supplierName, 120) && data.supplierName.size() > 0
        && validText(data.orderNumber, 30) && data.orderNumber.size() > 0
        && validOptionalText(data, 'notes', 500)
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 50
        && data.totalCents is int && data.totalCents >= 0 && data.totalCents < 100000000000
        && data.receivedCents == 0
        && isOwnAuthorship(data.createdBy)
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && supplier.status == 'active'
        && supplier.name == data.supplierName;
    }

    function isPurchaseOrderReceipt(oldData, newData) {
      return oldData.status in ['pending', 'partial']
        && newData.status in ['partial', 'received']
        && changedKeys().hasOnly(['status', 'items', 'receivedCents', 'updatedAt',
          'receivedAt', 'lastReceivedBy'])
        && newData.items is list && newData.items.size() == oldData.items.size()
        && newData.receivedCents is int
        && newData.receivedCents >= oldData.receivedCents
        && newData.receivedCents < 100000000000
        && newData.updatedAt == request.time
        && newData.receivedAt == request.time
        && isOwnAuthorship(newData.lastReceivedBy);
    }

    function isPurchaseOrderCancellation(oldData, newData) {
      return oldData.status == 'pending'
        && newData.status == 'cancelled'
        && changedKeys().hasOnly(['status', 'updatedAt', 'cancelledAt', 'cancelledBy'])
        && newData.updatedAt == request.time
        && newData.cancelledAt == request.time
        && isOwnAuthorship(newData.cancelledBy);
    }

    // ===============================================================
    // Rules (everything not matched below is denied)
    // ===============================================================

    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);

      allow create: if (isAdmin() && isNewUserProfile(request.resource.data, userId))
        || (isOwner(userId) && isSelfRegistration(request.resource.data));

      // Admins manage profiles; everyone else may only refresh their own last access data.
      allow update: if (isAdmin()
          && changedKeys().hasOnly(['username', 'email', 'displayName', 'photoURL', 'authType',
            'role', 'status', 'permissions', 'storeId', 'updatedAt', 'lastLogin'])
          && isValidUser(request.resource.data)
          && request.resource.data.get('uid', userId) == userId)
        || (isOwner(userId)
          && changedKeys().hasOnly(['lastLogin', 'photoURL'])
          && validOptionalText(request.resource.data, 'photoURL', 500)
          && validOptionalText(request.resource.data, 'lastLogin', 40));

      allow delete: if isAdmin();
    }

    match /cashShifts/{shiftId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.cashierId == request.auth.uid);

      allow create: if canOperatePOS()
        && canOperateStore(request.resource.data.storeId)
        && isValidOpenCashShift(request.resource.data, shiftId)
        && isOpenShiftLinkedToRegister(request.resource.data);

      allow update: if isOwner(resource.data.cashierId)
        && resource.data.status == 'open'
        && request.resource.data.shiftId == shiftId
        && (isValidCashShiftClose(resource.data, request.resource.data)
          || isValidCashShiftSaleUpdate(resource.data, request.resource.data, shiftId));

      allow delete: if false;
    }

    // A deterministic register document per user prevents concurrent open shifts.
    // The shift written in the same batch carries the permission and store checks.
    match /cashRegisters/{cashierId} {
      allow read: if isAdmin() || isOwner(cashierId);

      allow create: if isOwner(cashierId)
        && isValidCashRegister(request.resource.data, cashierId)
        && request.resource.data.status == 'open'
        && isOpenShiftLinkedToRegister(request.resource.data);

      allow update: if isOwner(cashierId)
        && isValidCashRegister(request.resource.data, cashierId)
        && changedKeys().hasOnly(['storeId', 'shiftId', 'status', 'updatedAt'])
        && (
          (resource.data.status == 'open'
            && request.resource.data.status == 'closed'
            && request.resource.data.shiftId == resource.data.shiftId
            && isClosedShiftLinkedToRegister(request.resource.data))
          || (resource.data.status == 'closed'
            && request.resource.data.status == 'open'
            && request.resource.data.shiftId != resource.data.shiftId
            && isOpenShiftLinkedToRegister(request.resource.data))
        );

      allow delete: if false;
    }

    match /stores/{storeId} {
      allow read: if isActiveStaff();
      allow create: if isAdmin() && isValidStore(request.resource.data);
      allow update: if (isAdmin() && isValidStore(request.resource.data))
        || isCashShiftStoreCounterIncrease(storeId)
        || isCashShiftStoreCounterDecrease(storeId);
      allow delete: if false;
    }

    // Central catalog: readable by any active staff, written only by admins and supervisors.
    // Products are archived, never deleted.
    match /catalogProducts/{catalogId} {
      allow read: if isActiveStaff();
      allow create: if isPurchasingStaff() && isNewCatalogProduct(request.resource.data);
      allow update: if isPurchasingStaff()
        && changedKeys().hasOnly(['name', 'category', 'unit', 'color', 'price', 'minStock', 'status',
          'updatedAt'])
        && hasValidCatalogFields(request.resource.data)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Per-store stock (and optional own price) of a catalog product.
    match /stockItems/{stockId} {
      allow read: if canAccessStore(resource.data.get('storeId', null));

      allow create: if isPurchasingStaff()
        && canOperateStore(request.resource.data.storeId)
        && isNewStockItem(stockId, request.resource.data);

      allow update: if request.resource.data.storeId == resource.data.get('storeId', null)
        && request.resource.data.catalogId == resource.data.get('catalogId', null)
        && canOperateStore(resource.data.get('storeId', null))
        && validNonNegative(request.resource.data.currentStock)
        && validNonNegative(request.resource.data.minStock)
        && (
          // Sales, restocks and audits adjust stock (and its audit trail) only.
          changedKeys().hasOnly(['currentStock', 'lastRestockedBy', 'lastRestockedAt'])
          // Purchase receipts also refresh the unit cost and, optionally, the store price.
          || (isPurchasingStaff()
            && changedKeys().hasOnly(['currentStock', 'cost', 'priceOverride', 'lastRestockedBy',
              'lastRestockedAt'])
            && hasValidStockFields(request.resource.data))
          // Only admins change the alert threshold.
          || (isAdmin()
            && changedKeys().hasOnly(['currentStock', 'minStock', 'cost', 'priceOverride',
              'lastRestockedBy', 'lastRestockedAt', 'minStockUpdatedBy', 'minStockUpdatedAt'])
            && hasValidStockFields(request.resource.data))
        );

      allow delete: if isAdmin()
        && isActiveStore(resource.data.get('storeId', null))
        && resource.data.currentStock == 0;
    }

    match /sales/{saleId} {
      allow read: if canAccessStore(resource.data.get('storeId', null));
      allow create: if canOperatePOS()
        && canOperateStore(request.resource.data.storeId)
        && isValidSale(request.resource.data);
      allow update, delete: if false;
    }

    match /inventoryMovements/{movementId} {
      allow read: if canAccessStore(resource.data.get('storeId', null));
      allow create: if canOperateStore(request.resource.data.storeId)
        && isValidMovement(request.resource.data)
        && (request.resource.data.type != 'audit' || isAdmin())
        && (request.resource.data.type != 'purchase' || isPurchasingStaff());
      allow update, delete: if false;
    }

    match /suppliers/{supplierId} {
      allow read: if isPurchasingStaff();
      allow create: if isPurchasingStaff() && isNewSupplier(request.resource.data);
      allow update: if isPurchasingStaff() && isSupplierUpdate(request.resource.data);
      allow delete: if false;
    }

    match /purchaseOrders/{orderId} {
      allow read: if isPurchasingStaff() && canAccessStore(resource.data.get('storeId', null));
      allow create: if isPurchasingStaff()
        && canOperateStore(request.resource.data.storeId)
        && isNewPurchaseOrder(request.resource.data);
      allow update: if isPurchasingStaff()
        && canOperateStore(resource.data.get('storeId', null))
        && (isPurchaseOrderReceipt(resource.data, request.resource.data)
          || isPurchaseOrderCancellation(resource.data, request.resource.data));
      allow delete: if false;
    }
  }
}
